# -----------------------------------------------------------------------------
# Application BASE URL
# For production, set to your domain, e.g. https://hook.tv
# For development, set to http://localhost:3000
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database
# BRAWLVERSE keeps its own tables (bouts / votes / bet_* / fantasy_* / ...)
# in the same Postgres instance; the template's auth tables live there too.
# -----------------------------------------------------------------------------
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Better Auth
# Generate a random string for the secret key using `openssl rand -base64 32`
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Github OAuth
# Get Client information from https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Google OAuth
# Get Client information from https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email (Resend)
# Get API key from https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2 or S3-compatible service)
# Used for user avatars only; show footage is served from /public/brawlverse.
# -----------------------------------------------------------------------------
STORAGE_REGION="auto"
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# -----------------------------------------------------------------------------
# Payment Provider
# BRAWLVERSE membership runs on Waffo Pancake. Set to 'waffo'.
# Signing and webhook verification live in src/lib/brawlverse/waffo.ts and must
# not be modified — only configure the values below.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENT_PROVIDER="waffo"

# -----------------------------------------------------------------------------
# Payment (Waffo Pancake)
# WAFFO_PRIVATE_KEY is server-only; keep its PEM newlines escaped as \n.
# The webhook URL to configure in the Waffo dashboard is:
#   https://hook.tv/api/webhooks?op=waffo
# -----------------------------------------------------------------------------
WAFFO_DEBUG=""
WAFFO_MERCHANT_ID=""
WAFFO_PRIVATE_KEY=""
# Optional: overrides the built-in Waffo webhook public key
WAFFO_WEBHOOK_PUBLIC_KEY=""
# Which Waffo environment the incoming webhooks belong to ('test' | 'prod').
# Events from another environment are ignored, so test traffic cannot touch
# production entitlements. Leave empty to accept both.
# Only 'test' | 'prod' are accepted; 'live' is normalized to 'prod' by the
# webhook handler.
WAFFO_ENV="prod"

# -----------------------------------------------------------------------------
# Membership tier product ids (one per tier in /tickets)
# Create the products in the Waffo dashboard, then paste the ids here.
# Product ids are not secrets, so they can be NEXT_PUBLIC_.
#
#   RINGSIDE  $4.99 / month   subscription
#   BOOKER    $14.99 / month  subscription
#   PROMOTER  $49 / month     subscription
#   LIFETIME  $199 once       one-time (leave empty to hide the tier)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WAFFO_PRODUCT_RINGSIDE=""
NEXT_PUBLIC_WAFFO_PRODUCT_BOOKER=""
NEXT_PUBLIC_WAFFO_PRODUCT_PROMOTER=""
NEXT_PUBLIC_WAFFO_PRODUCT_LIFETIME=""

# -----------------------------------------------------------------------------
# OpenRouter (Booker script generation in the admin console)
# Model must be an OpenRouter model id, e.g. openai/gpt-4o-mini
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (human verification for votes and danmaku)
# Leave both empty to skip verification entirely.
# The widget only renders when the site key is set.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# AdaptLane (weekly episode rendering — packaging shots only)
# feint submits text-to-video shots and receives a signed webhook back.
# Packaging shots (cold open / hero / result card / end card) go to AdaptLane;
# the fight shots come from the action-library pipeline instead.
#
# Local end-to-end test: `pnpm mock:adaptlane` (defaults to port 4001), then
# point ADAPTLANE_BASE_URL at it and reuse its key/secret.
# -----------------------------------------------------------------------------
# Missing key means "build the Brief only", no job is submitted and no error.
ADAPTLANE_API_KEY=""
# Defaults to https://adaptlane.com when empty.
ADAPTLANE_BASE_URL=""
# HMAC-SHA256 secret for the webhook; missing secret rejects callbacks with 503.
ADAPTLANE_WEBHOOK_SECRET=""
# Only 'on' lets the weekly Cron submit automatically; admin triggers ignore it.
ADAPTLANE_AUTOPILOT=""
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""
# Machine token: `X-Admin-Token` matching this value is treated as admin.
ADMIN_OPS_TOKEN=""
# Weekly render failure alert (Feishu/Slack/any endpoint accepting {"text"}).
OPS_ALERT_WEBHOOK=""

# -----------------------------------------------------------------------------
# Configurations
# Disable image optimization, check out next.config.ts for more details
# -----------------------------------------------------------------------------
DISABLE_IMAGE_OPTIMIZATION=false
# -----------------------------------------------------------------------------
# Demo website switch. MUST stay false for production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_WEBSITE=false

# -----------------------------------------------------------------------------
# Analytics (all optional, all disabled by default)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT="https://cloud.umami.is/script.js"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=""
NEXT_PUBLIC_DATAFAST_DOMAIN=""

# -----------------------------------------------------------------------------
# Notification (Discord / Feishu) — optional
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""
FEISHU_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# AI Gateway (Vercel AI Gateway) — optional, used by nothing in BRAWLVERSE
# -----------------------------------------------------------------------------
AI_GATEWAY_API_KEY=""
